# Engram — Lifecycle Config, FULLY ENABLED (Evaporation LIVE + Reflection + A-MAC)
# Example config: a long-running single agent whose memory should *age* — and
# whose evaporation sweep is allowed to actually MUTATE stored importance.
#
# This is the ENABLED sibling of examples/lifecycle.env. Same 58 ENGRAM_* keys,
# same section layout — but flipped out of observe-only mode:
#   ENGRAM_EVAPORATION_ENABLED=true  AND  ENGRAM_EVAPORATION_DRY_RUN=false
# so the background sweep writes decayed importance + evicts, instead of only
# reporting candidates. Reflection V2 and A-MAC are on too.
#
# ⚠️  Non-dry-run evaporation MUTATES a real store. Read README.md — especially
#     the RISK and ROLL BACK sections — before pointing this at production data.
#
# Every ENGRAM_* name below is spelled exactly as in docs/configuration.md and
# each carries its code-derived default. Copy to .env and fill in your values.

# ── Storage ────────────────────────────────────────────────────────────────────
# Local Qdrant over gRPC (6334). Lifecycle features add no storage requirements.
# What: Qdrant endpoint. Default: localhost:6334 (config.go).
ENGRAM_QDRANT_URL=localhost:6334

# ── Embedding ──────────────────────────────────────────────────────────────────
# What: embedding provider; evaporation/reflection are embedder-agnostic. Default: openai (config.go).
ENGRAM_EMBEDDER_PROVIDER=openai
# What: OpenAI API key for embeddings. Default: "" (config.go). Placeholder only — never a real key.
ENGRAM_OPENAI_API_KEY=sk-...
# What: embedding model name. Default: text-embedding-3-small (config.go).
ENGRAM_EMBEDDING_MODEL=text-embedding-3-small
# What: embedding vector dimension. Default: 1536 (config.go).
ENGRAM_EMBEDDING_DIMENSION=1536

# ── Transport ──────────────────────────────────────────────────────────────────
# What: which servers to run; "both" = MCP + HTTP so cron/curl can hit /reflect. Default: stdio (config.go).
ENGRAM_TRANSPORT=both
# What: HTTP listen port. Default: 8080 (config.go).
ENGRAM_HTTP_PORT=8080
# What: bearer token for the HTTP API. Default: "" (config.go). Placeholder only.
ENGRAM_API_KEY=replace-with-a-random-secret

# ── Evaporation: runtime importance decay (19 vars) ────────────────────────────
# Master switch — turns on the background sweep that mutates stored importance.
# What: enable evaporation sweep. Default: false (evaporation.go). ENABLED here.
ENGRAM_EVAPORATION_ENABLED=true
# ★ THE POINT OF THIS EXAMPLE ★ Live mode: the sweep WRITES decayed importance
# and evicts below-threshold memories instead of only reporting candidates.
# What: observe-only guard. Default: true (evaporation.go). Flipped to false here — LIVE.
ENGRAM_EVAPORATION_DRY_RUN=false
# What: event half-life in days (noisiest type). Default: 30 (evaporation.go).
ENGRAM_EVAPORATION_HALF_LIFE_EVENT=30
# What: insight half-life in days; raw material reflection feeds on. Default: 180 (evaporation.go).
ENGRAM_EVAPORATION_HALF_LIFE_INSIGHT=180
# What: directive half-life; 0 = never decay (also P1-protected). Default: 0 (evaporation.go).
ENGRAM_EVAPORATION_HALF_LIFE_DIRECTIVE=0
# What: identity half-life; 0 = never decay. Default: 0 (evaporation.go).
ENGRAM_EVAPORATION_HALF_LIFE_IDENTITY=0
# What: recall survival-credit strength (log access boost). Default: 0.15 (evaporation.go). Raised to 0.20.
ENGRAM_EVAPORATION_ACCESS_BOOST_ALPHA=0.20
# What: evict once decayed importance falls below this. Default: 1.0 (evaporation.go).
ENGRAM_EVAPORATION_EVICTION_THRESHOLD=1.0
# What: hours between sweeps. Default: 6 (evaporation.go). Widened to 12 to halve Qdrant churn.
ENGRAM_EVAPORATION_SWEEP_INTERVAL_H=12
# What: max memories processed per sweep. Default: 100 (evaporation.go). Raised to 200 for the longer interval.
ENGRAM_EVAPORATION_SWEEP_BATCH_LIMIT=200
# What: decay clock basis; last_access keeps recalled memories alive. Default: last_access (evaporation.go).
ENGRAM_EVAPORATION_DECAY_BASIS=last_access
# What: P8 floor — never evaporate anything younger than this many days. Default: 14 (evaporation.go).
ENGRAM_EVAPORATION_MIN_AGE_DAYS=14
# What: window between soft-deprecate and hard-delete eligibility (days). Default: 30 (evaporation.go).
ENGRAM_EVAPORATION_OBSERVATION_DAYS=30
# What: P1 structurally-exempt types regardless of half-life. Default: identity,directive (evaporation.go).
ENGRAM_EVAPORATION_PROTECT_TYPES=identity,directive
# What: P2 importance floor — at/above this is never evaporated. Default: 8 (evaporation.go).
ENGRAM_EVAPORATION_PROTECT_IMPORTANCE=8
# What: P3 access-count floor. Default: 5 (evaporation.go).
ENGRAM_EVAPORATION_PROTECT_ACCESS_COUNT=5
# What: P4 exempt if accessed within this many days. Default: 30 (evaporation.go).
ENGRAM_EVAPORATION_PROTECT_RECENT_ACCESS_DAYS=30
# What: P5 exempt memories carrying any of these tags. Default: permanent,frank-feedback,directive,identity (evaporation.go).
ENGRAM_EVAPORATION_PROTECT_TAGS=permanent,frank-feedback,directive,identity
# What: P7 exempt memories with non-empty provenance_history (dedup merge target). Default: true (evaporation.go).
ENGRAM_EVAPORATION_PROTECT_CORROBORATED=true

# ── Reflection Engine: ON, V2 mode ─────────────────────────────────────────────
# What: enable the automatic reflection trigger. Default: false (config.go). ENABLED here.
ENGRAM_REFLECTION_ENABLED=true
# What: trigger strategy; count fires on unreflected-memory backlog. Default: count (config.go).
ENGRAM_REFLECTION_TRIGGER=count
# What: unreflected count that fires a run. Default: 10 (config.go). Raised to 15 since evaporation thins events.
ENGRAM_REFLECTION_COUNT=15
# What: reflection pipeline; v2 = 4-stage focal→evidence→dialectic→synthesis. Default: "" (config.go).
ENGRAM_REFLECTION_MODE=v2
# What: dialectic-stage LLM timeout (clamped at 90s). Default: 0 = 45s (config.go). Set to 60s.
ENGRAM_DIALECTIC_TIMEOUT=60s

# What: Anthropic key for V2 reflection LLM calls; if unset V2 degrades to V1. Non-ENGRAM (ignored by CI). Placeholder only.
ANTHROPIC_API_KEY=

# ── A-MAC: type-aware admission control ────────────────────────────────────────
# What: enable per-type dedup / importance clamp / write rate limit. Default: false (config.go). ENABLED here.
ENGRAM_AMAC_ENABLED=true
# What: identity dedup threshold (protective). Default: 0.95 (dedup.go).
ENGRAM_DEDUP_THRESHOLD_IDENTITY=0.95
# What: directive dedup threshold (aggressive, prevents rule pile-up). Default: 0.90 (dedup.go).
ENGRAM_DEDUP_THRESHOLD_DIRECTIVE=0.90
# What: insight dedup threshold. Default: 0.92 (dedup.go).
ENGRAM_DEDUP_THRESHOLD_INSIGHT=0.92
# What: event dedup threshold. Default: 0.92 (dedup.go). Tightened to 0.90 for the volume lane.
ENGRAM_DEDUP_THRESHOLD_EVENT=0.90
# What: default importance when caller omits it. Defaults: identity 7, directive 7, insight 5, event 4 (config.go).
ENGRAM_IMPORTANCE_DEFAULT_IDENTITY=7
ENGRAM_IMPORTANCE_DEFAULT_DIRECTIVE=7
ENGRAM_IMPORTANCE_DEFAULT_INSIGHT=5
ENGRAM_IMPORTANCE_DEFAULT_EVENT=4
# What: per-type importance clamp bounds (out-of-range silently clamped). Defaults: id 7–9, dir 6–10, ins 5–8, evt 3–7 (config.go).
ENGRAM_IMPORTANCE_MIN_IDENTITY=7
ENGRAM_IMPORTANCE_MAX_IDENTITY=9
ENGRAM_IMPORTANCE_MIN_DIRECTIVE=6
ENGRAM_IMPORTANCE_MAX_DIRECTIVE=10
ENGRAM_IMPORTANCE_MIN_INSIGHT=5
ENGRAM_IMPORTANCE_MAX_INSIGHT=8
ENGRAM_IMPORTANCE_MIN_EVENT=3
ENGRAM_IMPORTANCE_MAX_EVENT=7
# What: sliding 1h write caps per (collection, type). Defaults: id 5, dir 10, ins 20, evt 50 (config.go). Event lowered to 30.
ENGRAM_RATE_LIMIT_IDENTITY=5
ENGRAM_RATE_LIMIT_DIRECTIVE=10
ENGRAM_RATE_LIMIT_INSIGHT=20
ENGRAM_RATE_LIMIT_EVENT=30

# ── Statedir ───────────────────────────────────────────────────────────────────
# What: where reflection trigger + dream-engine gate state persist. Default: resolves
# ENGRAM_STATE_DIR > $SIRI_HOME/.siri > $HOME/.siri > /root/.siri (pkg/statedir). Set explicitly for systemd.
ENGRAM_STATE_DIR=/var/lib/engram/state

# ── Observability ──────────────────────────────────────────────────────────────
# What: enable OTel tracing (set "false" to disable). Default: true (internal/otel/config.go).
ENGRAM_OTEL_ENABLED=true
# What: trace exporter (file|stdout|none). Default: file (internal/otel/config.go).
ENGRAM_OTEL_EXPORTER=file
# What: directory for file-exporter traces. Default: /tmp/siri-state/engram-traces (internal/otel/config.go).
ENGRAM_OTEL_FILE_DIR=/var/log/engram/traces
# What: trace sample ratio; 1.0 = sample all (sweeps/reflections are low-frequency). Default: 1.0 (internal/otel/config.go).
ENGRAM_OTEL_SAMPLE_RATIO=1.0
