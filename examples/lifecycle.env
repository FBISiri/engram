# Engram — Lifecycle Config (Evaporation + Reflection)
# Example config #2: a long-running single agent whose memory should *age*.
#
# Use this when:
#   - One agent runs for months and its store grows faster than it forgets
#   - Old low-value events should fade on their own instead of via manual pruning
#   - You want insights synthesized from what survives (Reflection V2)
#   - Writes should be admitted per type (A-MAC) so noisy events can't crowd out directives
#
# Design philosophy:
#   - Medium-strength evaporation: events fade in weeks, insights in months, identity never
#   - Recall keeps a memory alive: access boost slightly above default
#   - Reflection ON, V2 mode: dialectic pipeline over the memories that evaporation left standing
#   - A-MAC ON with built-in per-type defaults; only the event lane is tightened
#   - Explicit state dir so reflection/dream trigger state survives a $HOME-less systemd unit
#
# Every ENGRAM_* name below is spelled exactly as in docs/configuration.md.
# Copy to .env and fill in your values.

# ── Storage ────────────────────────────────────────────────────────────────────
# Local Qdrant over gRPC (6334). Lifecycle features add no storage requirements.
ENGRAM_QDRANT_URL=localhost:6334

# ── Embedding ──────────────────────────────────────────────────────────────────
# Default provider/model; evaporation and reflection are embedder-agnostic.
ENGRAM_EMBEDDER_PROVIDER=openai
ENGRAM_OPENAI_API_KEY=sk-...
ENGRAM_EMBEDDING_MODEL=text-embedding-3-small
ENGRAM_EMBEDDING_DIMENSION=1536

# ── Transport ──────────────────────────────────────────────────────────────────
# MCP for the agent + HTTP so you can hit /reflect and /reflect/check from cron or curl.
ENGRAM_TRANSPORT=both
ENGRAM_HTTP_PORT=8080
ENGRAM_API_KEY=replace-with-a-random-secret

# ── Evaporation: runtime importance decay (9 vars) ─────────────────────────────
# Master switch — turns on the background sweep that mutates stored importance.
ENGRAM_EVAPORATION_ENABLED=true
# Events are the noisiest type; 14d (vs default 30) halves their lifetime so the store stays lean.
ENGRAM_EVAPORATION_HALF_LIFE_EVENT=14
# Insights keep the default 180d — they are the raw material reflection feeds on.
ENGRAM_EVAPORATION_HALF_LIFE_INSIGHT=180
# Directives keep the default 365d — rules should outlast the events that produced them.
ENGRAM_EVAPORATION_HALF_LIFE_DIRECTIVE=365
# 0 = identity never decays. Who the agent is must not evaporate.
ENGRAM_EVAPORATION_HALF_LIFE_IDENTITY=0
# 0.20 (default 0.15): a memory that keeps getting recalled earns a bit more survival credit.
ENGRAM_EVAPORATION_ACCESS_BOOST_ALPHA=0.20
# Evict once decayed importance falls below 1.0 (default) — anything lower is noise by then.
ENGRAM_EVAPORATION_EVICTION_THRESHOLD=1.0
# Sweep every 12h instead of 6h: with 14d event half-life, twice a day is plenty and halves Qdrant churn.
ENGRAM_EVAPORATION_SWEEP_INTERVAL_H=12
# 200 per sweep (default 100) to compensate for the longer interval so backlog never builds.
ENGRAM_EVAPORATION_SWEEP_BATCH_LIMIT=200

# ── Reflection Engine: ON, V2 mode ─────────────────────────────────────────────
# Enable the automatic trigger; without it only manual reflection_run works.
ENGRAM_REFLECTION_ENABLED=true
# Count-based trigger: fires when enough unreflected memories accumulate (guardrails: 2h min interval, 3/day).
ENGRAM_REFLECTION_TRIGGER=count
# 15 (default 10): with evaporation thinning events, wait for a slightly larger batch so each run has substance.
ENGRAM_REFLECTION_COUNT=15
# v2 = 4-stage focal-point pipeline (focal → evidence → dialectic → synthesis); see docs/reflection.md.
ENGRAM_REFLECTION_MODE=v2
# 60s (default 45s, clamped at 90s): the dialectic stage is the slowest LLM call; give it headroom without hitting the clamp.
ENGRAM_DIALECTIC_TIMEOUT=60s
# Required for V2's LLM calls; if unset V2 silently degrades to V1 flat synthesis.
ANTHROPIC_API_KEY=

# ── A-MAC: type-aware admission control ────────────────────────────────────────
# Enable per-type dedup / importance clamp / write rate limit. Global ENGRAM_DEDUP_THRESHOLD is then only a fallback.
ENGRAM_AMAC_ENABLED=true
# Protective (default 0.95): only near-identical identity memories merge.
ENGRAM_DEDUP_THRESHOLD_IDENTITY=0.95
# Aggressive (default 0.90): prevents directive pile-up from paraphrased rules.
ENGRAM_DEDUP_THRESHOLD_DIRECTIVE=0.90
# Default 0.92: insights should merge on paraphrase but keep distinct angles.
ENGRAM_DEDUP_THRESHOLD_INSIGHT=0.92
# 0.90 (default 0.92): tightened — events are the volume lane, so catch more near-duplicates before they evaporate anyway.
ENGRAM_DEDUP_THRESHOLD_EVENT=0.90
# Per-type default importance when the caller omits it (defaults 7/7/5/4) — kept, they match the TTL matrix.
ENGRAM_IMPORTANCE_DEFAULT_IDENTITY=7
ENGRAM_IMPORTANCE_DEFAULT_DIRECTIVE=7
ENGRAM_IMPORTANCE_DEFAULT_INSIGHT=5
ENGRAM_IMPORTANCE_DEFAULT_EVENT=4
# Per-type clamp bounds (defaults): out-of-range values are silently clamped, which keeps evaporation half-lives meaningful.
ENGRAM_IMPORTANCE_MIN_IDENTITY=7
ENGRAM_IMPORTANCE_MAX_IDENTITY=9
ENGRAM_IMPORTANCE_MIN_DIRECTIVE=6
ENGRAM_IMPORTANCE_MAX_DIRECTIVE=10
ENGRAM_IMPORTANCE_MIN_INSIGHT=5
ENGRAM_IMPORTANCE_MAX_INSIGHT=8
ENGRAM_IMPORTANCE_MIN_EVENT=3
ENGRAM_IMPORTANCE_MAX_EVENT=7
# Sliding 1h write caps per (collection, type). Event cap lowered 50→30: evaporation handles aging, admission handles flooding.
ENGRAM_RATE_LIMIT_IDENTITY=5
ENGRAM_RATE_LIMIT_DIRECTIVE=10
ENGRAM_RATE_LIMIT_INSIGHT=20
ENGRAM_RATE_LIMIT_EVENT=30

# ── Statedir ───────────────────────────────────────────────────────────────────
# Where reflection trigger state and the dream-engine gate persist (pkg/statedir).
# Resolution order: ENGRAM_STATE_DIR > $SIRI_HOME/.siri > $HOME/.siri > /root/.siri.
# Set explicitly so a systemd unit without $HOME still keeps reflection cadence across restarts.
# NOTE: documented in docs/configuration.md — "State Directory" section / Complete Variable Reference #42.
ENGRAM_STATE_DIR=/var/lib/engram/state

# ── Observability ──────────────────────────────────────────────────────────────
# Full sampling: lifecycle sweeps and reflection runs are low-frequency, so tracing them all is cheap and useful.
ENGRAM_OTEL_ENABLED=true
ENGRAM_OTEL_EXPORTER=file
ENGRAM_OTEL_FILE_DIR=/var/log/engram/traces
ENGRAM_OTEL_SAMPLE_RATIO=1.0
