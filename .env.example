# Engram Configuration
# Copy to .env and fill in your values

# Embedder provider: "openai" (default) | "voyage"
# ENGRAM_EMBEDDER_PROVIDER=openai

# --- OpenAI / OpenRouter embedder ---
# Required when ENGRAM_EMBEDDER_PROVIDER=openai
ENGRAM_OPENAI_API_KEY=sk-...
# ENGRAM_OPENAI_BASE_URL=https://api.openai.com/v1
# ENGRAM_EMBEDDING_MODEL=text-embedding-3-small
# ENGRAM_EMBEDDING_DIMENSION=1536

# --- Voyage AI embedder ---
# Required when ENGRAM_EMBEDDER_PROVIDER=voyage
# ENGRAM_VOYAGE_API_KEY=pa-...
# ENGRAM_EMBEDDING_MODEL=voyage-3.5
# ENGRAM_EMBEDDING_DIMENSION=1024

# --- LLM client (reflection + dream engines) ---
# Provider switch. Unset/unknown => "openrouter" (default, unchanged behaviour).
# ENGRAM_LLM_PROVIDER=openrouter
#
# openrouter: OpenAI-compatible chat/completions API. ENGRAM_LLM_API_KEY required.
ENGRAM_LLM_API_KEY=sk-or-...
# ENGRAM_LLM_BASE_URL=https://openrouter.ai/api/v1
# ENGRAM_LLM_MODEL=anthropic/claude-sonnet-5
# ENGRAM_LLM_MAX_TOKENS=1500
# ENGRAM_LLM_DIALECTIC_MAX_TOKENS=4000
# ENGRAM_LLM_MAX_TOKENS_CEILING=8000
#
# anthropic: direct Anthropic Messages API (POST {base}/v1/messages).
# TEMPORARY workaround (2026-09-21) for OpenRouter's Hong Kong region block on
# Anthropic/OpenAI/Google models ("llm returned status 402"). The openrouter
# path above stays and remains the default; flip back once the block is lifted.
# When ENGRAM_LLM_PROVIDER=anthropic:
#   - ENGRAM_LLM_API_KEY is NOT required.
#   - ENGRAM_LLM_BASE_URL defaults to https://api.anthropic.com
#   - ENGRAM_LLM_MODEL defaults to claude-sonnet-5 (a leading "anthropic/" is stripped).
#   - credentials resolve in order: ANTHROPIC_API_KEY (X-Api-Key) ->
#     CLAUDE_CODE_OAUTH_TOKEN (Bearer) -> /root/.claude/.credentials.json
#     claudeAiOauth.accessToken (Bearer), read fresh per call (token rotates).
# ENGRAM_LLM_PROVIDER=anthropic

# Optional: Qdrant settings (defaults shown)
# ENGRAM_QDRANT_URL=localhost:6334
# ENGRAM_COLLECTION_NAME=engram
# QDRANT_API_KEY=
